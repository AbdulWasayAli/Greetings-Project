@model User
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "User Details";
}

<div class="content-page">
    <div class="content">
        <div class="container-fluid">
            <!-- start page title -->
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <div class="page-title-right">
                            <a href="@Url.Action("EditUser", "Admin", new { id = Model.Id })" class="btn btn-warning me-2">
                                <i class="mdi mdi-pencil"></i> Edit User
                            </a>
                            <a href="@Url.Action("Users", "Admin")" class="btn btn-primary">
                                <i class="mdi mdi-arrow-left"></i> Back to Users
                            </a>
                        </div>
                        <h4 class="page-title">User Details</h4>
                    </div>
                </div>
            </div>
            <!-- end page title -->

            <div class="row">
                <div class="col-lg-8 offset-lg-2">
                    <div class="card">
                        <div class="card-body">
                            <div class="text-center mb-4">
                                <div class="avatar-lg rounded-circle bg-primary mx-auto mb-3">
                                    <span class="avatar-title text-white" style="font-size: 3em;">
                                        @Model.Name.Substring(0, 1).ToUpper()
                                    </span>
                                </div>
                                <h3 class="mb-0">@Model.Name</h3>
                                <span class="badge @(Model.Role == "Admin" ? "bg-danger" : "bg-success") fs-6">
                                    @Model.Role
                                </span>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">User ID:</label>
                                        <p class="form-control-plaintext">@Model.Id</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Role:</label>
                                        <p class="form-control-plaintext">
                                            <span class="badge @(Model.Role == "Admin" ? "bg-danger" : "bg-success")">
                                                @Model.Role
                                            </span>
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Full Name:</label>
                                        <p class="form-control-plaintext">@Model.Name</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Phone Number:</label>
                                        <p class="form-control-plaintext">
                                            @if (!string.IsNullOrEmpty(Model.Phone))
                                            {
                                                <a href="tel:@Model.Phone" class="text-success">@Model.Phone</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not provided</span>
                                            }
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Email Address:</label>
                                        <p class="form-control-plaintext">
                                            <a href="mailto:@Model.Email" class="text-primary">
                                                <i class="mdi mdi-email"></i> @Model.Email
                                            </a>
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <hr>

                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted">Subscription Status</h6>
                                    @if (ViewBag.HasActiveSubscription && ViewBag.ActiveSubscription != null)
                                    {
                                        var subscription = ViewBag.ActiveSubscription as Subscription;
                                        if (subscription != null)
                                        {
                                            <div>
                                                <span class="badge bg-success">@subscription.PlanType Plan Active</span>
                                                <br>
                                                <small class="text-muted">
                                                    Expires: @subscription.EndDate.ToString("MMM dd, yyyy")
                                                    (@subscription.DaysRemaining() days left)
                                                </small>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No Active Subscription</span>
                                    }
                                </div>
                                <div class="text-end">
                                    <h6 class="text-muted">Quick Actions</h6>
                                    <div class="btn-group">
                                        <a href="@Url.Action("EditUser", "Admin", new { id = Model.Id })" 
                                           class="btn btn-sm btn-warning">
                                            <i class="mdi mdi-pencil"></i> Edit
                                        </a>
                                        @if (Model.Role != "Admin")
                                        {
                                            <a href="@Url.Action("DeleteUser", "Admin", new { id = Model.Id })" 
                                               class="btn btn-sm btn-danger"
                                               onclick="return confirm('Are you sure you want to delete this user?')">
                                                <i class="mdi mdi-delete"></i> Delete
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>