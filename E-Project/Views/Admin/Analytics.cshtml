@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Analytics";
}

<div class="content-page">
    <div class="content">
        <!-- Topbar Start -->
        <div class="navbar-custom">
            <ul class="list-unstyled topbar-menu float-end mb-0">
                <li class="dropdown notification-list">
                    <a class="nav-link dropdown-toggle nav-user arrow-none me-0" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="false" aria-expanded="false">
                        <span class="account-user-avatar">
                            <img src="~/Dashboard/assets/images/users/avatar-1.jpg" alt="user-image" class="rounded-circle">
                        </span>
                        <span>
                            <span class="account-user-name">Admin</span>
                            <span class="account-position">Administrator</span>
                        </span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end dropdown-menu-animated topbar-dropdown-menu profile-dropdown">
                        <a href="@Url.Action("Dashboard", "Admin")" class="dropdown-item notify-item">
                            <i class="mdi mdi-view-dashboard me-1"></i>
                            <span>Dashboard</span>
                        </a>
                        <a href="@Url.Action("Logout", "Admin")" class="dropdown-item notify-item">
                            <i class="mdi mdi-logout me-1"></i>
                            <span>Logout</span>
                        </a>
                    </div>
                </li>
            </ul>
            <button class="button-menu-mobile open-left">
                <i class="mdi mdi-menu"></i>
            </button>
        </div>
        <!-- end Topbar -->

        <!-- Start Content-->
        <div class="container-fluid">
            <!-- start page title -->
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <h4 class="page-title">Analytics Dashboard</h4>
                        <div class="page-title-right">
                            <ol class="breadcrumb m-0">
                                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Admin")">Admin</a></li>
                                <li class="breadcrumb-item active">Analytics</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
            <!-- end page title -->

            <!-- Analytics Cards -->
            <div class="row">
                <div class="col-xl-3 col-lg-6">
                    <div class="card widget-flat">
                        <div class="card-body">
                            <div class="float-end">
                                <i class="mdi mdi-account-multiple widget-icon bg-primary" style="color:white;"></i>
                            </div>
                            <h5 class="text-muted fw-normal mt-0">Total Users</h5>
                            <h3 class="mt-3 mb-3">@ViewBag.TotalUsers</h3>
                            <p class="mb-0 text-muted">
                                <span class="text-success me-2">@ViewBag.NewUsersThisMonth</span>
                                <span class="text-nowrap">New this month</span>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-lg-6">
                    <div class="card widget-flat">
                        <div class="card-body">
                            <div class="float-end">
                                <i class="mdi mdi-send widget-icon bg-success"></i>
                            </div>
                            <h5 class="text-muted fw-normal mt-0">Cards Sent</h5>
                            <h3 class="mt-3 mb-3">@ViewBag.TotalCardsSent</h3>
                            <p class="mb-0 text-muted">
                                <span class="text-info me-2">@ViewBag.CardsSentThisMonth</span>
                                <span class="text-nowrap">This month</span>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-lg-6">
                    <div class="card widget-flat">
                        <div class="card-body">
                            <div class="float-end">
                                <i class="mdi mdi-currency-usd widget-icon bg-warning"></i>
                            </div>
                            <h5 class="text-muted fw-normal mt-0">Total Revenue</h5>
                            <h3 class="mt-3 mb-3">$@ViewBag.TotalRevenue</h3>
                            <p class="mb-0 text-muted">
                                <span class="text-success me-2">$@ViewBag.MonthlyRevenue</span>
                                <span class="text-nowrap">This month</span>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-lg-6">
                    <div class="card widget-flat">
                        <div class="card-body">
                            <div class="float-end">
                                <i class="mdi mdi-chart-line widget-icon bg-info"></i>
                            </div>
                            <h5 class="text-muted fw-normal mt-0">Growth Rate</h5>
                            <h3 class="mt-3 mb-3">@ViewBag.GrowthRate%</h3>
                            <p class="mb-0 text-muted">
                                <span class="text-success me-2"><i class="mdi mdi-arrow-up-bold"></i>@ViewBag.TodaysCardsSent</span>
                                <span class="text-nowrap">Cards sent today</span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Popular Categories -->
            <div class="row">
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="header-title mb-3">Popular Categories</h4>
                            <div class="table-responsive">
                                <table class="table table-borderless table-nowrap table-hover table-centered m-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Category</th>
                                            <th>Cards Created</th>
                                            <th>Popularity</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var category in ViewBag.PopularCategories)
                                        {
                                            <tr>
                                                <td>@category.Category</td>
                                                <td>@category.Count</td>
                                                <td>
                                                    <div class="progress progress-sm">
                                                        <div class="progress-bar bg-success" 
                                                             style="width: @(category.Count * 10)%"></div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="header-title mb-3">Quick Actions</h4>
                            <div class="row">
                                <div class="col-sm-6">
                                    <a href="@Url.Action("Users", "Admin")" class="btn btn-primary btn-sm mb-2 w-100">
                                        <i class="mdi mdi-account-multiple me-1"></i>
                                        Manage Users
                                    </a>
                                </div>
                                <div class="col-sm-6">
                                    <a href="@Url.Action("Cards", "Admin")" class="btn btn-success btn-sm mb-2 w-100">
                                        <i class="mdi mdi-card-text me-1"></i>
                                        Manage Cards
                                    </a>
                                </div>
                                <div class="col-sm-6">
                                    <a href="@Url.Action("Subscriptions", "Admin")" class="btn btn-warning btn-sm mb-2 w-100">
                                        <i class="mdi mdi-credit-card me-1"></i>
                                        Subscriptions
                                    </a>
                                </div>
                                <div class="col-sm-6">
                                    <a href="@Url.Action("Reports", "Admin")" class="btn btn-info btn-sm mb-2 w-100">
                                        <i class="mdi mdi-file-document me-1"></i>
                                        View Reports
                                    </a>
                                </div>
                            </div>

                            <hr>

                            <h5 class="mb-3">System Health</h5>
                            <div class="mb-3">
                                <span class="float-end">95%</span>
                                <h6 class="text-uppercase">Server Performance</h6>
                                <div class="progress progress-sm">
                                    <div class="progress-bar bg-success" style="width: 95%"></div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <span class="float-end">78%</span>
                                <h6 class="text-uppercase">User Satisfaction</h6>
                                <div class="progress progress-sm">
                                    <div class="progress-bar bg-info" style="width: 78%"></div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <span class="float-end">85%</span>
                                <h6 class="text-uppercase">Card Delivery Rate</h6>
                                <div class="progress progress-sm">
                                    <div class="progress-bar bg-primary" style="width: 85%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div> <!-- container -->
    </div> <!-- content -->
</div>