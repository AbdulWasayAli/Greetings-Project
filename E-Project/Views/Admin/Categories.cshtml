@model List<Category>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Manage Categories";
}

<div class="content-page">
    <div class="content">
        <div class="container-fluid">
            <!-- start page title -->
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <div class="page-title-right">
                            <a href="@Url.Action("CreateCategory", "Admin")" class="btn btn-success me-2">
                                <i class="mdi mdi-plus"></i> Add New Category
                            </a>
                            <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-primary">
                                <i class="mdi mdi-arrow-left"></i> Back to Dashboard
                            </a>
                        </div>
                        <h4 class="page-title">Manage Categories</h4>
                    </div>
                </div>
            </div>
            <!-- end page title -->

            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="header-title">All Categories</h4>
                                <span class="badge bg-info">Total: @Model.Count</span>
                            </div>

                            <div class="row">
                                @foreach (var category in Model)
                                {
                                    <div class="col-lg-4 col-md-6">
                                        <div class="card">
                                            <div class="card-body text-center">
                                                @if (!string.IsNullOrEmpty(category.ImagePath))
                                                {
                                                    <img src="@category.ImagePath" alt="@category.CategoryName" class="img-fluid mb-2" style="height: 150px; object-fit: cover; width: 100%;">
                                                }
                                                else
                                                {
                                                    <div class="bg-light d-flex align-items-center justify-content-center mb-2" style="height: 150px;">
                                                        <i class="mdi mdi-image" style="font-size: 3em; color: #ccc;"></i>
                                                    </div>
                                                }
                                                
                                                <h5 class="card-title">@category.CategoryName</h5>
                                                <p class="text-muted">ID: @category.CategoryID</p>
                                                
                                                <div class="btn-group w-100">
                                                    <a href="@Url.Action("EditCategory", "Admin", new { id = category.CategoryID })" 
                                                       class="btn btn-sm btn-info">
                                                        <i class="mdi mdi-pencil"></i> Edit
                                                    </a>
                                                    <a href="@Url.Action("DeleteCategory", "Admin", new { id = category.CategoryID })" 
                                                       class="btn btn-sm btn-danger"
                                                       onclick="return confirm('Are you sure you want to delete this category? This will also affect all cards in this category.')">
                                                        <i class="mdi mdi-delete"></i> Delete
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            
                            @if (!Model.Any())
                            {
                                <div class="text-center py-4">
                                    <i class="mdi mdi-shape-outline" style="font-size: 3em; color: #ccc;"></i>
                                    <h5 class="mt-2 text-muted">No Categories Found</h5>
                                    <p class="text-muted">Create your first category to organize your cards.</p>
                                    <a href="@Url.Action("CreateCategory", "Admin")" class="btn btn-success">
                                        <i class="mdi mdi-plus"></i> Create First Category
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>