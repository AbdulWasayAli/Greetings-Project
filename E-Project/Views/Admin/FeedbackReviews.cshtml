@model List<Feedback>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Feedback Reviews";
}

<div class="content-page">
    <div class="content">
        <div class="container-fluid">
            <!-- start page title -->
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <div class="page-title-right">
                            <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-primary">
                                <i class="mdi mdi-arrow-left"></i> Back to Dashboard
                            </a>
                        </div>
                        <h4 class="page-title">Customer Feedback Reviews</h4>
                    </div>
                </div>
            </div>
            <!-- end page title -->

            <!-- Statistics Cards -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h4 class="mb-1">@ViewBag.TotalFeedbacks</h4>
                                    <p class="mb-0">Total Feedback</p>
                                </div>
                                <i class="mdi mdi-message-text-outline fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h4 class="mb-1">@(Model?.Count(f => f.SubmittedAt >= DateTime.Now.AddDays(-7)) ?? 0)</h4>
                                    <p class="mb-0">This Week</p>
                                </div>
                                <i class="mdi mdi-calendar-week fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-info text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h4 class="mb-1">@(Model?.Count(f => f.SubmittedAt >= DateTime.Now.AddDays(-30)) ?? 0)</h4>
                                    <p class="mb-0">This Month</p>
                                </div>
                                <i class="mdi mdi-calendar-month fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Feedback Table -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="header-title">Customer Feedback</h4>
                            <p class="text-muted mb-0">Review feedback from users showing which user gave what feedback</p>
                        </div>
                        <div class="card-body">
                            @if (Model != null && Model.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead>
                                            <tr>
                                                <th>User Name</th>
                                                <th>Email</th>
                                                <th>Message</th>
                                                <th>Submitted At</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var feedback in Model)
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <div class="avatar-sm me-2">
                                                                <span class="avatar-title bg-primary rounded-circle">
                                                                    @feedback.UserName.FirstOrDefault()
                                                                </span>
                                                            </div>
                                                            <div>
                                                                <strong>@feedback.UserName</strong>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <a href="mailto:@feedback.Email">@feedback.Email</a>
                                                    </td>
                                                    <td>
                                                        <div class="message-cell">
                                                            @if (feedback.Message.Length > 100)
                                                            {
                                                                <span class="message-preview">@feedback.Message.Substring(0, 100)...</span>
                                                                <a href="#" class="text-primary expand-message ms-2" onclick="toggleMessage(this)">
                                                                    <small>Read more</small>
                                                                </a>
                                                                <span class="message-full" style="display: none;">@feedback.Message</span>
                                                                <a href="#" class="text-primary collapse-message ms-2" onclick="toggleMessage(this)" style="display: none;">
                                                                    <small>Show less</small>
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                @feedback.Message
                                                            }
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <small class="text-muted">
                                                            @feedback.SubmittedAt.ToString("MMM dd, yyyy")<br>
                                                            @feedback.SubmittedAt.ToString("hh:mm tt")
                                                        </small>
                                                    </td>
                                                    <td>
                                                        <div class="dropdown">
                                                            <a class="btn btn-link text-muted" href="#" role="button" data-bs-toggle="dropdown">
                                                                <i class="mdi mdi-dots-vertical"></i>
                                                            </a>
                                                            <div class="dropdown-menu dropdown-menu-end">
                                                                <a class="dropdown-item" href="mailto:@feedback.Email">
                                                                    <i class="mdi mdi-email-outline me-1"></i> Reply
                                                                </a>
                                                                <div class="dropdown-divider"></div>
                                                                <a class="dropdown-item text-danger" href="@Url.Action("DeleteFeedback", "Admin", new { id = feedback.Id })" 
                                                                   onclick="return confirm('Are you sure you want to delete this feedback?')">
                                                                    <i class="mdi mdi-trash-can-outline me-1"></i> Delete
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4">
                                    <div class="avatar-lg mx-auto mb-3">
                                        <div class="avatar-title bg-soft-primary text-primary rounded-circle">
                                            <i class="mdi mdi-message-text-outline" style="font-size: 24px;"></i>
                                        </div>
                                    </div>
                                    <h5>No Feedback Yet</h5>
                                    <p class="text-muted">Customer feedback will appear here once users start submitting feedback.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function toggleMessage(element) {
    const messageCell = element.closest('.message-cell');
    const preview = messageCell.querySelector('.message-preview');
    const full = messageCell.querySelector('.message-full');
    const expandLink = messageCell.querySelector('.expand-message');
    const collapseLink = messageCell.querySelector('.collapse-message');
    
    if (preview.style.display !== 'none') {
        // Show full message
        preview.style.display = 'none';
        expandLink.style.display = 'none';
        full.style.display = 'inline';
        collapseLink.style.display = 'inline';
    } else {
        // Show preview
        preview.style.display = 'inline';
        expandLink.style.display = 'inline';
        full.style.display = 'none';
        collapseLink.style.display = 'none';
    }
}
</script>