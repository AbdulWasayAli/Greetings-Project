@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Dashboard";
}

<div class="content-page">
    <div class="content">
        <!-- Topbar Start -->
        <div class="navbar-custom">
            <ul class="list-unstyled topbar-menu float-end mb-0">
                <li class="dropdown notification-list">
                    <a class="nav-link dropdown-toggle nav-user arrow-none me-0" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="false" aria-expanded="false">
                        <span class="account-user-avatar">
                            <img src="~/Dashboard/assets/images/users/avatar-1.jpg" alt="user-image" class="rounded-circle">
                        </span>
                        <span>
                            <span class="account-user-name">@ViewBag.AdminName</span>
                            <span class="account-position">Admin</span>
                        </span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end dropdown-menu-animated topbar-dropdown-menu profile-dropdown">
                        <div class="dropdown-header noti-title">
                            <h6 class="text-overflow m-0">Welcome!</h6>
                        </div>
                        <a href="@Url.Action("Users", "Admin")" class="dropdown-item notify-item">
                            <i class="mdi mdi-account-multiple me-1"></i>
                            <span>Manage Users</span>
                        </a>
                        <a href="@Url.Action("Categories", "Admin")" class="dropdown-item notify-item">
                            <i class="mdi mdi-shape me-1"></i>
                            <span>Manage Categories</span>
                        </a>
                        <a href="@Url.Action("Cards", "Admin")" class="dropdown-item notify-item">
                            <i class="mdi mdi-card-text me-1"></i>
                            <span>Manage Cards</span>
                        </a>
                        <a href="@Url.Action("FeedbackReviews", "Admin")" class="dropdown-item notify-item">
                            <i class="mdi mdi-star me-1"></i>
                            <span>Feedback Reviews</span>
                        </a>
                        <a href="@Url.Action("ContactMessages", "Admin")" class="dropdown-item notify-item">
                            <i class="mdi mdi-email-outline me-1"></i>
                            <span>Contact Messages</span>
                        </a>
                        <a href="@Url.Action("Logout", "Admin")" class="dropdown-item notify-item">
                            <i class="mdi mdi-logout me-1"></i>
                            <span>Logout</span>
                        </a>
                    </div>
                </li>
            </ul>
            <button class="button-menu-mobile open-left">
                <i class="mdi mdi-menu"></i>
            </button>
        </div>
        <!-- end Topbar -->
        
        <!-- Start Content-->
        <div class="container-fluid">
            <!-- start page title -->
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <h4 class="page-title">Admin Dashboard</h4>
                        <p>Welcome, @ViewBag.AdminName! Manage your platform from here.</p>
                    </div>
                </div>
            </div>
            <!-- end page title -->
            
            <!-- Display Info Messages -->
            @if (TempData["InfoMessage"] != null)
            {
                <div class="row">
                    <div class="col-12">
                        <div class="alert alert-info alert-dismissible fade show" role="alert">
                            <i class="mdi mdi-information-outline me-2"></i>
                            @TempData["InfoMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
            }
            
            <!-- Statistics Cards -->
            <div class="row">
                <div class="col-xl-3 col-lg-6">
                    <div class="card widget-flat">
                        <div class="card-body">
                            <div class="float-end">
                                <i class="mdi mdi-account-multiple widget-icon"></i>
                            </div>
                            <h5 class="text-muted fw-normal mt-0">Total Users</h5>
                            <h3 class="mt-3 mb-3">@ViewBag.TotalUsers</h3>
                            <p class="mb-0 text-muted">
                                <span class="text-success me-2"><i class="mdi mdi-arrow-up-bold"></i>Active</span>
                                <span class="text-nowrap">Registered Users</span>
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="col-xl-3 col-lg-6">
                    <div class="card widget-flat">
                        <div class="card-body">
                            <div class="float-end">
                                <i class="mdi mdi-card-text widget-icon"></i>
                            </div>
                            <h5 class="text-muted fw-normal mt-0">Total Cards</h5>
                            <h3 class="mt-3 mb-3">@ViewBag.TotalCards</h3>
                            <p class="mb-0 text-muted">
                                <span class="text-info me-2"><i class="mdi mdi-arrow-up-bold"></i>Available</span>
                                <span class="text-nowrap">E-Cards Created</span>
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="col-xl-3 col-lg-6">
                    <div class="card widget-flat">
                        <div class="card-body">
                            <div class="float-end">
                                <i class="mdi mdi-shape widget-icon"></i>
                            </div>
                            <h5 class="text-muted fw-normal mt-0">Categories</h5>
                            <h3 class="mt-3 mb-3">@ViewBag.TotalCategories</h3>
                            <p class="mb-0 text-muted">
                                <span class="text-primary me-2"><i class="mdi mdi-arrow-up-bold"></i>Available</span>
                                <span class="text-nowrap">Card Categories</span>
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="col-xl-3 col-lg-6">
                    <div class="card widget-flat">
                        <div class="card-body">
                            <div class="float-end">
                                <i class="mdi mdi-email-outline widget-icon"></i>
                            </div>
                            <h5 class="text-muted fw-normal mt-0">Contact Messages</h5>
                            <h3 class="mt-3 mb-3">@ViewBag.TotalContactMessages</h3>
                            <p class="mb-0 text-muted">
                                <span class="text-info me-2"><i class="mdi mdi-email-open-outline"></i></span>
                                <span class="text-nowrap">Messages Received</span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <!-- end Statistics Cards -->
            
            <!-- Subscription Statistics Row -->
            <div class="row">
                <div class="col-xl-4 col-lg-6">
                    <div class="card widget-flat">
                        <div class="card-body">
                            <div class="float-end">
                                <i class="mdi mdi-crown widget-icon bg-success-lighten text-success"></i>
                            </div>
                            <h5 class="text-muted fw-normal mt-0">Total Subscriptions</h5>
                            <h3 class="mt-3 mb-3">@ViewBag.TotalSubscriptions</h3>
                            <p class="mb-0 text-muted">
                                <span class="text-success me-2"><i class="mdi mdi-arrow-up-bold"></i>All Time</span>
                                <span class="text-nowrap">Pro Subscriptions</span>
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="col-xl-4 col-lg-6">
                    <div class="card widget-flat">
                        <div class="card-body">
                            <div class="float-end">
                                <i class="mdi mdi-check-circle widget-icon bg-primary-lighten text-primary"></i>
                            </div>
                            <h5 class="text-muted fw-normal mt-0">Active Subscriptions</h5>
                            <h3 class="mt-3 mb-3">@ViewBag.ActiveSubscriptions</h3>
                            <p class="mb-0 text-muted">
                                <span class="text-primary me-2"><i class="mdi mdi-arrow-up-bold"></i>Current</span>
                                <span class="text-nowrap">Active Pro Users</span>
                            </p>
                        </div>
                    </div>
                </div>
                
                <div class="col-xl-4 col-lg-6">
                    <div class="card widget-flat">
                        <div class="card-body">
                            <div class="float-end">
                                <i class="mdi mdi-currency-usd widget-icon bg-warning-lighten text-warning"></i>
                            </div>
                            <h5 class="text-muted fw-normal mt-0">Total Revenue</h5>
                            <h3 class="mt-3 mb-3">$@ViewBag.TotalRevenue?.ToString("F2")</h3>
                            <p class="mb-0 text-muted">
                                <span class="text-warning me-2"><i class="mdi mdi-arrow-up-bold"></i>Earned</span>
                                <span class="text-nowrap">From Subscriptions</span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <!-- end subscription statistics -->
            
            <!-- Pro Subscription Management -->
            <div class="row">
                <div class="col-md-4 d-flex justify-content-center">
                    <!-- Left Section: Pro Plan Details (Centered) -->
                    <div class="card border-success" style="width: 100%; max-width: 300px;">
                        <div class="card-body text-center">
                            <h5 class="card-title text-success">Pro Plan</h5>
                            <h3 class="text-success">$9.99</h3>
                            <p class="text-muted">Monthly</p>
                            <div id="pro-plan-users" class="mb-3">
                                <span class="badge bg-success fs-6">0 Users</span>
                            </div>
                            <ul class="list-unstyled">
                                <li>✓ Send up to 10 Emails/day</li>
                                <li>✓ All card templates</li>
                                <li>✓ Email delivery</li>
                                <li>✓ Usage tracking</li>
                            </ul>
                            <button class="btn btn-success" onclick="subscriptionManager.showUpgradeModal()">
                                Upgrade User
                            </button>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-8">
                    <!-- Right Section: Active Subscriptions -->
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="header-title mb-0">Active Subscriptions</h4>
                                <span class="badge bg-info">Scroll to load more</span>
                            </div>
                            <div id="subscriptions-container" class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                                <table class="table table-centered table-nowrap mb-0">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th>User</th>
                                            <th>Plan</th>
                                            <th>Start Date</th>
                                            <th>End Date</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="subscriptions-list">
                                        <!-- Dynamic content will be loaded here -->
                                    </tbody>
                                </table>
                                <div id="loading-spinner" class="text-center py-3" style="display: none;">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </div>
                                <div id="no-more-data" class="text-center py-3 text-muted" style="display: none;">
                                    <small>No more subscribers to load</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- end Pro Subscription Management -->
            
            <!-- Quick Actions -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="header-title mb-3">Quick Actions</h4>
                            <div class="row text-center">
                                <div class="col-md-3">
                                    <a href="@Url.Action("Users", "Admin")" class="btn btn-primary btn-lg mb-2 w-100">
                                        <i class="mdi mdi-account-multiple d-block mb-1" style="font-size: 2em;"></i>
                                        Manage Users
                                    </a>
                                </div>
                                <div class="col-md-3">
                                    <a href="@Url.Action("Categories", "Admin")" class="btn btn-info btn-lg mb-2 w-100">
                                        <i class="mdi mdi-shape d-block mb-1" style="font-size: 2em;"></i>
                                        Categories
                                    </a>
                                </div>
                                <div class="col-md-3">
                                    <a href="@Url.Action("Cards", "Admin")" class="btn btn-success btn-lg mb-2 w-100">
                                        <i class="mdi mdi-card-text d-block mb-1" style="font-size: 2em;"></i>
                                        Manage Cards
                                    </a>
                                </div>
                                <div class="col-md-3">
                                    <a href="@Url.Action("FeedbackReviews", "Admin")" class="btn btn-warning btn-lg mb-2 w-100">
                                        <i class="mdi mdi-star d-block mb-1" style="font-size: 2em;"></i>
                                        Reviews
                                    </a>
                                </div>
                            </div>
                            
                            <hr>
                            
                            <div class="row text-center">
                                <div class="col-md-4">
                                    <a href="@Url.Action("ContactMessages", "Admin")" class="btn btn-outline-primary w-100">
                                        <i class="mdi mdi-email-outline"></i> Contact Messages
                                    </a>
                                </div>
                                <div class="col-md-4">
                                    <a href="@Url.Action("CreateCategory", "Admin")" class="btn btn-outline-info w-100">
                                        <i class="mdi mdi-plus"></i> Add New Category
                                    </a>
                                </div>
                                <div class="col-md-4">
                                    <a href="@Url.Action("CreateCard", "Admin")" class="btn btn-outline-success w-100">
                                        <i class="mdi mdi-plus"></i> Create New Card
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- end Quick Actions -->
        </div>
        <!-- end container -->
    </div>
    <!-- end content -->
    
    <!-- Footer -->
    <footer class="footer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-6">
                    <script>document.write(new Date().getFullYear())</script> © E-Project Admin Panel
                </div>
                <div class="col-md-6">
                    <div class="text-md-end footer-links d-none d-md-block">
                        <a href="@Url.Action("Dashboard", "Admin")">Dashboard</a>
                        <a href="@Url.Action("Users", "Admin")">Users</a>
                        <a href="@Url.Action("Cards", "Admin")">Cards</a>
                        <a href="@Url.Action("Categories", "Admin")">Categories</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <!-- end Footer -->
</div>

<!-- Upgrade Modal -->
<div class="modal fade" id="upgradeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upgrade User to Pro Plan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="upgrade-form">
                    <div class="mb-3">
                        <label class="form-label">Select User</label>
                        <select class="form-select" id="user-select" required>
                            <option value="">Loading users...</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Plan</label>
                        <input type="text" class="form-control" value="Pro Plan - $9.99/month" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Duration</label>
                        <select class="form-select" id="duration" required>
                            <option value="1">1 Month</option>
                            <option value="3">3 Months</option>
                            <option value="6">6 Months</option>
                            <option value="12">12 Months</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Payment Method</label>
                        <select class="form-select" id="payment-method">
                            <option value="Card">Credit Card</option>
                            <option value="PayPal">PayPal</option>
                            <option value="Admin">Admin Credit</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="subscriptionManager.upgradePlan()">Create Subscription</button>
            </div>
        </div>
    </div>
</div>

<script>
class AdminSubscriptionManager {
    constructor() {
        this.init();
    }

    init() {
        this.loadSubscriptionStats();
        this.loadActiveSubscriptions();
        this.loadUsers();
    }

    showUpgradeModal() {
        const modal = new bootstrap.Modal(document.getElementById('upgradeModal'));
        modal.show();
    }

    async loadUsers() {
        try {
            const response = await fetch('/Admin/GetUsersForSubscription');
            const users = await response.json();
            
            const select = document.getElementById('user-select');
            select.innerHTML = '<option value="">Choose user...</option>';
            
            users.forEach(user => {
                const option = document.createElement('option');
                option.value = user.id;
                option.textContent = `${user.name} (${user.email}) - ${user.hasActiveSubscription ? 'Has Pro' : 'Free'}`;
                option.disabled = user.hasActiveSubscription;
                select.appendChild(option);
            });
        } catch (error) {
            console.error('Error loading users:', error);
        }
    }

    async upgradePlan() {
        const userId = parseInt(document.getElementById('user-select').value);
        const duration = parseInt(document.getElementById('duration').value);
        const paymentMethod = document.getElementById('payment-method').value;
        
        if (!userId) {
            this.showNotification('Please select a user!', 'error');
            return;
        }

        try {
            const response = await fetch('/Admin/CreateSubscription', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    userId: userId,
                    planType: 'Pro',
                    amount: 9.99 * duration,
                    duration: duration,
                    paymentMethod: paymentMethod
                })
            });

            const result = await response.json();
            
            if (result.success) {
                this.showNotification(result.message, 'success');
                
                // Close modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('upgradeModal'));
                modal.hide();
                
                // Refresh data
                this.loadSubscriptionStats();
                this.loadActiveSubscriptions();
                this.loadUsers();
            } else {
                this.showNotification(result.message, 'error');
            }
        } catch (error) {
            this.showNotification('Error creating subscription: ' + error.message, 'error');
        }
    }

    async cancelSubscription(subscriptionId) {
        if (!confirm('Are you sure you want to cancel this subscription?')) {
            return;
        }

        try {
            const response = await fetch(`/Admin/CancelSubscription/${subscriptionId}`, {
                method: 'POST'
            });

            const result = await response.json();
            
            if (result.success) {
                this.showNotification(result.message, 'success');
                this.loadSubscriptionStats();
                this.loadActiveSubscriptions();
            } else {
                this.showNotification(result.message, 'error');
            }
        } catch (error) {
            this.showNotification('Error cancelling subscription: ' + error.message, 'error');
        }
    }

    async loadSubscriptionStats() {
        // Simulate loading subscription stats
        // In real implementation, this would call an API endpoint
        document.getElementById('pro-plan-users').innerHTML = 
            '<span class="badge bg-success fs-6">Loading...</span>';
        
        // Update with dynamic data when available
        setTimeout(() => {
            document.getElementById('pro-plan-users').innerHTML = 
                '<span class="badge bg-success fs-6"></span>';
        }, 1000);
    }

    async loadActiveSubscriptions() {
        // Initialize pagination state
        this.currentPage = 0;
        this.pageSize = 5;
        this.hasMoreData = true;
        this.isLoading = false;
        
        const tbody = document.getElementById('subscriptions-list');
        const container = document.getElementById('subscriptions-container');
        const loadingSpinner = document.getElementById('loading-spinner');
        const noMoreData = document.getElementById('no-more-data');
        
        // Clear existing data
        tbody.innerHTML = '';
        noMoreData.style.display = 'none';
        
        // Load initial data
        await this.loadMoreSubscriptions();
        
        // Set up scroll event listener for infinite scroll
        container.addEventListener('scroll', () => {
            if (container.scrollTop + container.clientHeight >= container.scrollHeight - 5) {
                this.loadMoreSubscriptions();
            }
        });
    }
    
    async loadMoreSubscriptions() {
        if (this.isLoading || !this.hasMoreData) return;
        
        this.isLoading = true;
        const loadingSpinner = document.getElementById('loading-spinner');
        const noMoreData = document.getElementById('no-more-data');
        
        loadingSpinner.style.display = 'block';
        
        try {
            const skip = this.currentPage * this.pageSize;
            const response = await fetch(`/Admin/GetActiveSubscriptions?skip=${skip}&take=${this.pageSize}`);
            const result = await response.json();
            
            if (result.success && result.data) {
                const tbody = document.getElementById('subscriptions-list');
                
                if (result.data.length === 0 && this.currentPage === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No active subscriptions found</td></tr>';
                } else if (result.data.length > 0) {
                    const rows = result.data.map(sub => `
                        <tr>
                            <td>${sub.userName}<br><small class="text-muted">${sub.userEmail}</small></td>
                            <td><span class="badge bg-success">${sub.planType}</span></td>
                            <td>${sub.startDate}</td>
                            <td>${sub.endDate}</td>
                            <td><span class="badge bg-success">${sub.status}</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger" onclick="subscriptionManager.cancelSubscription(${sub.id})">
                                    Deactivate 
                                </button>
                            </td>
                        </tr>
                    `).join('');
                    
                    tbody.innerHTML += rows;
                    this.currentPage++;
                }
                
                this.hasMoreData = result.hasMore;
                
                if (!this.hasMoreData) {
                    noMoreData.style.display = 'block';
                }
            }
            
        } catch (error) {
            console.error('Error loading subscriptions:', error);
            if (this.currentPage === 0) {
                document.getElementById('subscriptions-list').innerHTML = 
                    '<tr><td colspan="6" class="text-center text-danger">Error loading subscriptions</td></tr>';
            }
        } finally {
            this.isLoading = false;
            loadingSpinner.style.display = 'none';
        }
    }

    showNotification(message, type) {
        const notification = document.createElement('div');
        notification.className = `alert alert-${type === 'error' ? 'danger' : type} alert-dismissible fade show position-fixed`;
        notification.style.cssText = 'top: 20px; left: 50%; transform: translateX(-50%); z-index: 1050; min-width: 300px; max-width: 500px;';
        notification.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        
        document.body.appendChild(notification);
        
        setTimeout(() => {
            notification.remove();
        }, 5000);
    }
}

// Initialize subscription manager when DOM is loaded
document.addEventListener('DOMContentLoaded', function() {
    window.subscriptionManager = new AdminSubscriptionManager();
});
</script>