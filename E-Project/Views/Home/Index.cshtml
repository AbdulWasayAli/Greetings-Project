<!-- Hero Section with Background Video -->
<section class="home" style="position:relative; width:100%; height:100vh; overflow:hidden;">
    <!-- Background Video -->
    <video autoplay muted loop playsinline style="width:100%; height:100%; object-fit:cover;">
        <source src="~/User/images/video.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video>

    <!-- Dark Overlay -->
    <div class="video-overlay"></div>

    <!-- Overlay Text -->
    <div class="overlay-text">
        <h1>
            <span style="color:#ffae00;">Welcome</span> to Greetings Cards ✨
        </h1>
        <p>
            Create and customize your own cards, add anything you like, and share them with your loved ones instantly!
        </p>
        <a href="#categories" class="btn" id="getStartedBtn">Get Started</a>
    </div>
</section>

<!-- Categories Section (scroll target) -->
<section id="categories" style="min-height:100vh; padding:80px 20px; background:#f7f7f7;">
    <!-- home content -->
    @model IEnumerable<Category>

    <div class="container py-5">
        <header class="header">
            <h1 class="text-center">Choose Your Greetings Categories</h1>
        </header>

        <!-- Search Error/Suggestions Section -->
        @if (!string.IsNullOrEmpty(ViewBag.SearchError))
        {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert" data-aos="fade-down">
                        <div class="d-flex align-items-start">
                            <div class="flex-shrink-0">
                                <i class="fas fa-search fa-2x text-info"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h5 class="alert-heading mb-2">
                                    <i class="fas fa-spell-check"></i> Search Results for "@ViewBag.SearchTerm"
                                </h5>
                                <p class="mb-3">@ViewBag.SearchError</p>
                                
                                @if (ViewBag.SearchSuggestions != null && ((IEnumerable<Category>)ViewBag.SearchSuggestions).Any())
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (Category suggestion in (IEnumerable<Category>)ViewBag.SearchSuggestions)
                                        {
                                            <a href="@Url.Action("Cards", new { id = suggestion.CategoryID })" 
                                               class="btn btn-outline-info btn-sm rounded-pill">
                                                <i class="fas fa-tag me-1"></i>@suggestion.CategoryName
                                            </a>
                                        }
                                    </div>
                                }
                                
                                <hr class="my-3">
                                <div class="text-muted small">
                                    <strong>💡 Tip:</strong> Try searching for: Birthday, Wedding, Christmas, Diwali, New Year, Eid, or Thanksgiving
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            </div>
        }

        <br><br><br>

        <div class="row g-4">
            @{
                var index = 0;
            }
            @foreach (var cat in Model)
            {
                index++;
                var delay = index * 100; // 1→100, 2→200 ... 8→800
                                         <div class="col-md-3 col-sm-6" data-aos="zoom-in" data-aos-delay="@delay">
                                             <a asp-action="Cards" asp-route-id="@cat.CategoryID" class="text-decoration-none text-dark">
                                                 <div class="category-card">
                                                     <img src="@cat.ImagePath" alt="@cat.CategoryName" />
                                                     <h5><i>@cat.CategoryName</i></h5>
                                                 </div>
                                             </a>
                                         </div>
            }
        </div>
    </div>
</section>

<!-- JavaScript for Scroll -->
<script>
    document.getElementById("getStartedBtn").addEventListener("click", function (e) {
        e.preventDefault(); // default # jump ko rokna
        document.querySelector("#categories").scrollIntoView({
            behavior: "smooth"
        });
    });
</script>

<!-- CSS -->
<style>
    /* Dark overlay */
    .video-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 1;
    }

    /* Text Content */
    .overlay-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        color: #fff;
        z-index: 2;
        max-width: 700px;
        padding: 20px;
    }

        .overlay-text h1 {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 15px;
            text-shadow: 2px 2px 15px rgba(0,0,0,0.8);
            opacity: 0;
            animation: fadeInUp 1.2s ease forwards;
        }

        .overlay-text p {
            font-size: 1.3rem;
            margin-bottom: 25px;
            text-shadow: 1px 1px 8px rgba(0,0,0,0.6);
            opacity: 0;
            animation: fadeInUp 1.5s ease forwards;
            animation-delay: 0.3s;
        }

        /* Button */
        .overlay-text .btn {
            background: linear-gradient(135deg, #ffae00, #ff4f91);
            color: #fff;
            padding: 14px 35px;
            border-radius: 30px;
            text-decoration: none;
            font-size: 1.1rem;
            font-weight: bold;
            transition: all 0.3s ease-in-out;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
            opacity: 0;
            animation: zoomIn 1.2s ease forwards;
            animation-delay: 0.6s;
        }

            .overlay-text .btn:hover {
                transform: scale(1.1);
                background: linear-gradient(135deg, #ff4f91, #ffae00);
            }

    /* Keyframes */
    @@keyframes fadeInUp {
        0%

    {
        opacity: 0;
        transform: translateY(40px);
    }

    100% {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes zoomIn {
        0%

    {
        opacity: 0;
        transform: scale(0.8);
    }

    100% {
        opacity: 1;
        transform: scale(1);
    }

    }

    /* Smooth Scroll */
    html {
        scroll-behavior: smooth;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .overlay-text h1

    {
        font-size: 2rem;
    }

    .overlay-text p {
        font-size: 1rem;
    }

    .overlay-text .btn {
        padding: 10px 25px;
        font-size: 1rem;
    }

    }
</style>


