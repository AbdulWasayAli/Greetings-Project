    .wedding-pill {
        background: var(--muted); 
        border-radius: 999px;
        padding: 16px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        transition: all .2s ease;
        text-decoration: none; 
        color: inherit; /* default text color */
        outline: none; /* outline remove */
        box-shadow: none; /* blue shadow remove */
    }

        .wedding-pill h4 {
            font-size: 16px;
            font-weight: 600;
            margin: 0;
        }

    .wedding-pill {
        background: rgba(255, 143, 79, 0.1); /* light transparent orange */
    }


       
        .wedding-pill:hover {
            transform: translateX(6px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        }

            .wedding-pill:hover h4 {
                color: black;
            }
</style>



