<style>
    /* Wedding theme colors */
    :root {
        --wedding-accent: #ff8f4f; /* light orange instead of deep pink */
        --wedding-gold: #ffd700; /* keep gold or slightly warmer */
        --wedding-bg: #fff7f0; /* very light orange / cream background */
    }


    /* Wedding Wrap */
    .wedding-wrap {
        margin-top: 80px; 
        background: transparent;
        border-radius: 20px;
        box-shadow: none; 
    }

    /* Wedding Decor */
    .wedding-decor {
        background: var(--wedding-bg);
    }

        .wedding-decor::before {
            border-color: var(--wedding-accent); /* deep pink */
            animation: spin 14s linear infinite;
        }


        .wedding-decor::after {
            border-color: var(--wedding-accent);
            animation: pulse 8s ease-in-out infinite;
        }

    /* Headline Wedding Accent */
    .headline .wedding-accent {
        color: var(--wedding-accent);
        font-family: "Playfair Display", serif;
        font-size: 44px;
        font-weight: bold;
    }

