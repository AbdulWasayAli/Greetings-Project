 <div class="container" id="contact">
    <!-- Heading -->
    <div class="row">
        <div class="col-12 text-center">
            <h2 class="contact-title" data-aos="zoom-in" data-aos-duration="700">Get in Touch</h2>
           <p class="contact-subtitle" data-aos="fade-up" data-aos-delay="200">
  We’d love to hear from you. Reach us via phone, email, or simply send a message!!
</p>
        </div>
    </div>

   <!-- Contact Info -->
<div class="row justify-content-center mt-4">
  <div class="col-md-4 py-3">
    <div class="card contact-card text-center p-1">
      <i class="fas fa-phone fa-2x mb-2"></i>
      <h6>+9230000000</h6>
    </div>
  </div>

  <div class="col-md-4 py-3">
    <div class="card contact-card text-center p-1">
      <i class="fas fa-envelope fa-2x mb-2"></i>
      <h6>Cards@greetings.com</h6>
    </div>
  </div>

  <div class="col-md-4 py-3">
    <div class="card contact-card text-center p-1">
      <i class="fas fa-location-dot fa-2x mb-2"></i>
      <h6>Karachi, Sindh, Pakistan</h6>
    </div>
  </div>
</div>


   <!-- Contact Form -->
    

    <form asp-action="Contact" method="post" class="row g-3 mt-4 needs-validation" novalidate>
        <!-- Full Name -->
        <div class="col-md-4">
            <input type="text" class="form-control" name="Name" placeholder="Your Name"
                   pattern="[A-Za-z\s]{3,50}" required>
            <div class="invalid-feedback">Please enter a valid name (alphabets only).</div>
        </div>

        <!-- Email -->
        <div class="col-md-4">
            <input type="email" class="form-control" name="Email" placeholder="Your Email" required>
            <div class="invalid-feedback">Please enter a valid email address.</div>
        </div>

        <!-- Phone -->
        <div class="col-md-4">
            <input type="tel" class="form-control" name="Phone" placeholder="Your Phone"
                   pattern="[0-9]{11}" required>
            <div class="invalid-feedback">Please enter a valid 11-digit phone number.</div>
        </div>

        <!-- Message -->
        <div class="col-12">
            <textarea class="form-control" name="Message" rows="5" placeholder="Your Message" required></textarea>
            <div class="invalid-feedback">Message is required.</div>
        </div>

        <!-- Submit Button -->
        <div class="col-12 text-center mt-3">
            <button class="contact-btn" type="submit">Send Message</button>
        </div>
    </form>
    <br>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <style>
        /* Golden Glitter Effect on Hover */
        .form-control:hover {
            border: 2px solid #ffd700;
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.6), inset 0 0 20px rgba(255, 215, 0, 0.1);
            transform: translateY(-2px);
        }

            .form-control:hover::before {
                content: '';
                position: absolute;
                top: -10px;
                left: -10px;
                right: -10px;
                bottom: -10px;
                background: linear-gradient(45deg, transparent, rgba(255, 215, 0, 0.1), transparent, rgba(255, 215, 0, 0.2), transparent);
                background-size: 20px 20px;
                animation: glitter-sparkle 1.5s linear infinite;
                border-radius: 8px;
                z-index: -1;
                pointer-events: none;
            }

    </style>


<!-- JS for Bootstrap validation -->
<script>
(function () {
  'use strict';
  let forms = document.querySelectorAll('.needs-validation');

  Array.prototype.slice.call(forms).forEach(function (form) {
    form.addEventListener('submit', function (event) {
      if (!form.checkValidity()) {
        event.preventDefault();
        event.stopPropagation();
      }
      form.classList.add('was-validated');
    }, false);
  });
})();
</script>




</div>
<br>
<br>
<br>
