        <script>
    // Debug: Check if function exists when page loads
    console.log("=== CARDS.CSHTML SCRIPT LOADED ===");
    console.log("updateImageFromFile function exists:", typeof updateImageFromFile);
    
    // Test function to manually check file input
    window.testFileInput = function() {
        console.log("=== MANUAL FILE INPUT TEST ===");
        const input = document.getElementById('imageFile');
        console.log("Input element:", input);
        console.log("Input files:", input ? input.files : "no input");
        if (input && input.files && input.files.length > 0) {
            console.log("File found:", input.files[0]);
            updateImageFromFile({ target: { files: input.files } });
        } else {
            console.log("No files in input");
        }
    };

    // Update openCustomize function to set the selected template correctly
    function openCustomize(imagePath, title, message) {
        console.log("🚀 openCustomize called with:");
        console.log("  - imagePath:", imagePath);
        console.log("  - title:", title);
        console.log("  - message:", message);
        
        // Check both local and window variables for custom image
        const hasCustomImage = (customImageDataUrl && customImageDataUrl.length > 0) || 
                              (window.customImageDataUrl && window.customImageDataUrl.length > 0);
        
        console.log("Checking for custom image:");
        console.log("- customImageDataUrl:", !!customImageDataUrl, customImageDataUrl ? customImageDataUrl.length : 0);
        console.log("- window.customImageDataUrl:", !!window.customImageDataUrl, window.customImageDataUrl ? window.customImageDataUrl.length : 0);
        console.log("- hasCustomImage:", !!hasCustomImage);
        
        // If we have a custom image, preserve it and set template to custom
        if (hasCustomImage) {
            // Keep the custom image and template - restore from window if needed
            selectedTemplate = "custom";
            window.selectedTemplate = "custom";
            customImageDataUrl = customImageDataUrl || window.customImageDataUrl;
            window.customImageDataUrl = customImageDataUrl;
            
            console.log("✅ Custom image exists, preserving:");
            console.log("- selectedTemplate set to:", selectedTemplate);
            console.log("- customImageDataUrl length:", customImageDataUrl ? customImageDataUrl.length : 0);
            
            // Keep the custom image in preview
            document.getElementById("previewImage").src = customImageDataUrl;
            
            // Show the clear custom image button
            document.getElementById("clearCustomImageBtn").classList.remove("d-none");
        } else {
            // No custom image - use template
            selectedTemplate = mapImageSrcToTemplate(imagePath);
            window.selectedTemplate = selectedTemplate;
            customImageDataUrl = "";
            window.customImageDataUrl = "";
            
            console.log("🎯 No custom image exists, setting template to:", selectedTemplate);
            console.log("🎯 Image path used:", imagePath);
            console.log("🎯 Preview image will show:", imagePath);
            document.getElementById("previewImage").src = imagePath;
            
            // Hide the clear custom image button
            document.getElementById("clearCustomImageBtn").classList.add("d-none");
        }
        
        console.log("🏁 openCustomize FINAL STATE:");
        console.log("  - selectedTemplate:", selectedTemplate);
        console.log("  - window.selectedTemplate:", window.selectedTemplate);
        console.log("  - customImageDataUrl exists:", !!customImageDataUrl);
        console.log("  - Preview image src:", document.getElementById("previewImage").src);
        
        document.getElementById("cardTitle").value = title;
        document.getElementById("cardMessage").value = message;
        new bootstrap.Modal(document.getElementById("customizeModal")).show();
    }

    // Helper function to map image source to template name (exactly like SendCard logic)
    function mapImageSrcToTemplate(imageSrc) {
        console.log("🎯 mapImageSrcToTemplate called with:", imageSrc);
        
        let templateName = "birthday"; // default fallback
        
        if (imageSrc.includes("1c.jpg")) templateName = "birthday";
        else if (imageSrc.includes("2c.jpg")) templateName = "wedding";
        else if (imageSrc.includes("3c.jpg")) templateName = "newyear";
        else if (imageSrc.includes("4c.jpg")) templateName = "eid-fitr";
        else if (imageSrc.includes("5c.jpg")) templateName = "eid-adha";
        else if (imageSrc.includes("6c.jpg")) templateName = "christmas";
        else if (imageSrc.includes("7c.webp")) templateName = "thanksgiving";
        else if (imageSrc.includes("8c.jpg")) templateName = "diwali";
        
        console.log("🎯 Mapped to template:", templateName);
        console.log("🎯 Image path analysis:");
        console.log("  - Contains '1c.jpg':", imageSrc.includes("1c.jpg"));
        console.log("  - Contains '2c.jpg':", imageSrc.includes("2c.jpg"));
        console.log("  - Contains '3c.jpg':", imageSrc.includes("3c.jpg"));
        console.log("  - Contains '4c.jpg':", imageSrc.includes("4c.jpg"));
        console.log("  - Contains '5c.jpg':", imageSrc.includes("5c.jpg"));
        console.log("  - Contains '6c.jpg':", imageSrc.includes("6c.jpg"));
        console.log("  - Contains '7c.webp':", imageSrc.includes("7c.webp"));
        console.log("  - Contains '8c.jpg':", imageSrc.includes("8c.jpg"));
        
        return templateName;
    }

    // Email form submission using EXACT same logic as SendCard.cshtml
    document.getElementById("emailsForm").addEventListener("submit", function (e) {
        e.preventDefault();
        console.log("Email form submitted");

        // Validate form first
        if (!e.target.checkValidity()) {
            e.target.classList.add("was-validated");
            return;
        }

        // Get emails from form
        const emails = Array.from(document.querySelectorAll("#emailsContainer input"))
                            .map(i => i.value.trim())
                            .filter(e => e !== "");

        if (emails.length === 0) {
            alert("Please add at least one email address.");
            return;
        }

        // Get form data
        const title = document.getElementById("cardTitle").value.trim();
        const message = document.getElementById("cardMessage").value.trim();

        if (!title || !message) {
            alert("Please fill in both title and message.");
            return;
        }

        console.log("=== EMAIL FORM SUBMISSION DEBUG ===");
        console.log("🔥 Test value from updateImageFromFile:", window.testCustomImage);
        console.log("🔥 Image upload attempted:", window.imageUploadAttempted);
        console.log("🔥 Image upload timestamp:", window.imageUploadTimestamp);
        console.log("selectedTemplate:", selectedTemplate);
        console.log("window.selectedTemplate:", window.selectedTemplate);
        console.log("globalThis.selectedTemplate:", globalThis.selectedTemplate);
        console.log("customImageDataUrl exists:", !!customImageDataUrl);
        console.log("window.customImageDataUrl exists:", !!window.customImageDataUrl);
        console.log("globalThis.customImageDataUrl exists:", !!globalThis.customImageDataUrl);
        console.log("customImageDataUrl length:", customImageDataUrl ? customImageDataUrl.length : 0);
        console.log("window.customImageDataUrl length:", window.customImageDataUrl ? window.customImageDataUrl.length : 0);
        console.log("globalThis.customImageDataUrl length:", globalThis.customImageDataUrl ? globalThis.customImageDataUrl.length : 0);
        
        // Check sessionStorage as fallback
        let sessionTemplate = null;
        let sessionImageData = null;
        try {
            sessionTemplate = sessionStorage.getItem('selectedTemplate');
            sessionImageData = sessionStorage.getItem('customImageData');
            console.log("sessionStorage selectedTemplate:", sessionTemplate);
            console.log("sessionStorage customImageData exists:", !!sessionImageData);
            console.log("sessionStorage customImageData length:", sessionImageData ? sessionImageData.length : 0);
        } catch (e) {
            console.warn("Could not access sessionStorage:", e);
        }
        
        console.log("Form data:", { selectedTemplate, customImageDataUrl: !!customImageDataUrl, title, message, emails });

        // Prepare form data using multiple fallback sources
        let formData;
        
        // Use multiple sources with priority order
        const finalSelectedTemplate = window.selectedTemplate || globalThis.selectedTemplate || sessionTemplate || selectedTemplate || 'birthday';
        const finalCustomImageDataUrl = window.customImageDataUrl || globalThis.customImageDataUrl || sessionImageData || customImageDataUrl || '';
        
        console.log("Final values being used:");
        console.log("- finalSelectedTemplate:", finalSelectedTemplate);
        console.log("- finalCustomImageDataUrl length:", finalCustomImageDataUrl.length);
        console.log("- Source: window =", window.selectedTemplate, ", globalThis =", globalThis.selectedTemplate, ", session =", sessionTemplate, ", local =", selectedTemplate);
        console.log("- Image Source: window exists =", !!window.customImageDataUrl, ", globalThis exists =", !!globalThis.customImageDataUrl, ", session exists =", !!sessionImageData, ", local exists =", !!customImageDataUrl);
        
        if (finalSelectedTemplate === 'custom' && finalCustomImageDataUrl) {
            // For custom image, send the base64 data
            formData = {
                Image: 'custom',
                CustomImageData: finalCustomImageDataUrl,
                Title: title,
                Message: message,
                Emails: emails
            };
            console.log("✅ SENDING CUSTOM IMAGE DATA");
            console.log("- Image:", formData.Image);
            console.log("- CustomImageData length:", formData.CustomImageData.length);
        } else {
            // For template selection
            formData = {
                Image: finalSelectedTemplate,
                Title: title,
                Message: message,
                Emails: emails
            };
            console.log("❌ SENDING TEMPLATE (NOT CUSTOM)");
            console.log("- Image:", formData.Image);
            console.log("- Reason: finalSelectedTemplate is", finalSelectedTemplate, "and finalCustomImageDataUrl exists:", !!finalCustomImageDataUrl);
            console.log("- Original selectedTemplate was:", selectedTemplate);
            console.log("- Original customImageDataUrl exists:", !!customImageDataUrl);
        }

        // Show loading state
        const submitBtn = document.querySelector("#emailsForm button[type='submit']");
        const originalText = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Sending...';

        console.log("Sending request to /Home/SendCard with data:", formData);

        // Send using EXACT same logic as SendCard.cshtml
        fetch('/Home/SendCard', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify(formData)
        })
        .then(res => {
            console.log("Response received:", res.status);
            return res.json();
        })
        .then(data => {
            console.log("Response data:", data);
            if (data.success) {
                alert(`✅ ${data.message || "Card sent successfully!"}\n\nCards sent: ${data.cardsSent || emails.length}\nRemaining today: ${data.remainingCards || 0}`);
                // Close the modal
                bootstrap.Modal.getInstance(document.getElementById("emailsModal")).hide();
                // Reset form
                document.getElementById("emailsForm").reset();
                resetEmailContainer();
            } else {
                if (data.requiresSubscription) {
                    alert("❌ " + data.error + "\n\nWould you like to subscribe now?");
                    // Close email modal and show subscription modal
                    bootstrap.Modal.getInstance(document.getElementById("emailsModal")).hide();
                    new bootstrap.Modal(document.getElementById("subscribeModal")).show();
                } else {
                    alert("❌ " + (data.error || "Failed to send card. Please try again."));
                    if (data.details) {
                        console.error("Error details:", data.details);
                    }
                }
            }
        })
        .catch(err => {
            console.error("Network error:", err);
            alert("❌ Network error. Please check your connection and try again.");
        })
        .finally(() => {
            // Restore button state
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
        });
    });

    // Helper function to reset email container
    function resetEmailContainer() {
        document.getElementById("emailsContainer").innerHTML = `
            <div class="input-group mb-2 email-field">
                <input type="email" name="emails[]" class="form-control" placeholder="Enter email" required>
                <button type="button" class="btn btn-outline-danger d-none" onclick="removeEmailField(this)">Remove</button>
                <div class="invalid-feedback">Please enter a valid email address</div>
            </div>
        `;
        document.getElementById("addEmailBtn").classList.remove("d-none");
    }

        </script>