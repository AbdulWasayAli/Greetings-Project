<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    @if (ViewData["Title"]?.ToString() == "Home" || string.IsNullOrEmpty(ViewData["Title"]?.ToString()))
    {
        <title>Greetings - Spreading Smiles With Every Card</title>
    }
    else
    {
        <title>@ViewData["Title"] - Greetings</title>
    }

    <!-- Open Graph / WhatsApp / Facebook / LinkedIn Link Preview Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="http://greetings.runasp.net/" />
    <meta property="og:title" content="Greeting Cards - Spreading Smiles With Every Card ✨" />
    <meta property="og:description" content="Explore, personalize, and send dynamic digital greeting cards across diverse occasions and festivals with real-time previews and 3D card flips." />
    <meta property="og:image" content="https://raw.githubusercontent.com/AbdulWasayAli/Greetings-Project/main/docs/images/preview.jpg" />
    <meta property="og:image:secure_url" content="https://raw.githubusercontent.com/AbdulWasayAli/Greetings-Project/main/docs/images/preview.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="989" />
    <meta property="og:image:height" content="562" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="http://greetings.runasp.net/" />
    <meta name="twitter:title" content="Greeting Cards - Spreading Smiles With Every Card ✨" />
    <meta name="twitter:description" content="Explore, personalize, and send dynamic digital greeting cards across diverse occasions and festivals with real-time previews and 3D card flips." />
    <meta name="twitter:image" content="https://raw.githubusercontent.com/AbdulWasayAli/Greetings-Project/main/docs/images/preview.jpg" />

   
    
    <!-- Custom CSS -->
   
    <link rel="stylesheet" href="~/User/css/style.css" asp-append-version="true" />
    <link rel="icon" href="~/User/images/logo.png" type="image/png" sizes="16x16">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css">
  
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Merriweather&display=swap" rel="stylesheet">
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <!-- Swiper JS -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
   
    <link rel="stylesheet" href="~/User/css/cards.css">
    @* contact css *@
    <link rel="stylesheet" href="~/User/css/contact.css">
    @* feedback css *@
    <link rel="stylesheet" href="~/User/css/feedback.css">
    

   
    @* Aos Library links *@
    <link rel="stylesheet" href="~/lib/aos.library/aos.css" />
<script src="~/lib/aos.library/aos.js"></script>
    @* <link rel="stylesheet" href="~/User/css/glitter.css" /> *@

</head>
<body>
    <!-- Preloader -->
    <partial name="_Preloader"></partial>
    <!-- SubHeader -->
    @if (ViewBag.HideSubHeader != true)
    {
        <partial name="_SubHeader"></partial>
    }
    <!-- Header -->
    <partial name="_Header"></partial>
    <!-- Page Content -->
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
    <a href="#" class="arrow"><i><img src="~/User/images/arrow.png" alt=""></i></a>
    <!-- Footer -->
    <partial name="_Footer"></partial>




    <!-- Scripts -->
    @* aos library links *@
    <script>
        AOS.init({
            duration: 400,
            once: false,
            offset: 200
        });
    </script>

@* aos libaray links end *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/User/js/java.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    @* <script src="~/User/js/glitter.js"></script> *@


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
