@*------------- Dashboard Header , Left Bar & Right Bar ------------*@
<!-- Begin page -->
<div class="wrapper">
    <!-- ========== Left Sidebar Start ========== -->
    <div class="leftside-menu">

        <!-- LOGO -->
        <a href="@Url.Action("Dashboard", "Admin")" class="logo text-center logo-light">
            <span class="logo-lg">
                <img src="~/User/images/logo.png" alt="E-Project Logo" height="16">
            </span>
            <span class="logo-sm">
                <img src="~/User/images/logo.png" alt="E-Project Logo" height="16">
            </span>
        </a>

        <!-- LOGO -->
        <a href="@Url.Action("Dashboard", "Admin")" class="logo text-center logo-dark">
            <span class="logo-lg">
                <img src="~/User/images/logo.png" alt="E-Project Logo" height="16">
            </span>
            <span class="logo-sm">
                <img src="~/User/images/logo.png" alt="E-Project Logo" height="16">
            </span>
        </a>

        <div class="h-100" id="leftside-menu-container" data-simplebar>

            <!--- Sidemenu -->
            <ul class="side-nav">

                <li class="side-nav-title side-nav-item">Main</li>

                <li class="side-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")">
                    <a href="@Url.Action("Dashboard", "Admin")" class="side-nav-link">
                        <i class="mdi mdi-view-dashboard"></i>
                        <span> Dashboard </span>
                    </a>
                </li>

                <li class="side-nav-title side-nav-item">User Management</li>

                <li class="side-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Users" || ViewContext.RouteData.Values["Action"]?.ToString() == "CreateUser" ? "active" : "")">
                    <a data-bs-toggle="collapse" href="#sidebarUsers" aria-expanded="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Users" || ViewContext.RouteData.Values["Action"]?.ToString() == "CreateUser" ? "true" : "false")" aria-controls="sidebarUsers" class="side-nav-link">
                        <i class="mdi mdi-account-multiple"></i>
                        <span> Users </span>
                        <span class="menu-arrow"></span>
                    </a>
                    <div class="collapse @(ViewContext.RouteData.Values["Action"]?.ToString() == "Users" || ViewContext.RouteData.Values["Action"]?.ToString() == "CreateUser" ? "show" : "")" id="sidebarUsers">
                        <ul class="side-nav-second-level">
                            <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Users" ? "active" : "")">
                                <a href="@Url.Action("Users", "Admin")">All Users</a>
                            </li>
                            <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "CreateUser" ? "active" : "")">
                                <a href="@Url.Action("CreateUser", "Admin")">Add New User</a>
                            </li>
                        </ul>
                    </div>
                </li>

                <li class="side-nav-title side-nav-item">Content Management</li>

                <li class="side-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Cards" || ViewContext.RouteData.Values["Action"]?.ToString() == "CreateCard" ? "active" : "")">
                    <a data-bs-toggle="collapse" href="#sidebarCards" aria-expanded="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Cards" || ViewContext.RouteData.Values["Action"]?.ToString() == "CreateCard" ? "true" : "false")" aria-controls="sidebarCards" class="side-nav-link">
                        <i class="mdi mdi-card-text"></i>
                        <span> E-Cards </span>
                        <span class="menu-arrow"></span>
                    </a>
                    <div class="collapse @(ViewContext.RouteData.Values["Action"]?.ToString() == "Cards" || ViewContext.RouteData.Values["Action"]?.ToString() == "CreateCard" ? "show" : "")" id="sidebarCards">
                        <ul class="side-nav-second-level">
                            <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Cards" ? "active" : "")">
                                <a href="@Url.Action("Cards", "Admin")">All Cards</a>
                            </li>
                            <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "CreateCard" ? "active" : "")">
                                <a href="@Url.Action("CreateCard", "Admin")">Add New Card</a>
                            </li>
                        </ul>
                    </div>
                </li>

                <li class="side-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Categories" || ViewContext.RouteData.Values["Action"]?.ToString() == "CreateCategory" ? "active" : "")">
                    <a data-bs-toggle="collapse" href="#sidebarCategories" aria-expanded="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Categories" || ViewContext.RouteData.Values["Action"]?.ToString() == "CreateCategory" ? "true" : "false")" aria-controls="sidebarCategories" class="side-nav-link">
                        <i class="mdi mdi-shape"></i>
                        <span> Categories </span>
                        <span class="menu-arrow"></span>
                    </a>
                    <div class="collapse @(ViewContext.RouteData.Values["Action"]?.ToString() == "Categories" || ViewContext.RouteData.Values["Action"]?.ToString() == "CreateCategory" ? "show" : "")" id="sidebarCategories">
                        <ul class="side-nav-second-level">
                            <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Categories" ? "active" : "")">
                                <a href="@Url.Action("Categories", "Admin")">All Categories</a>
                            </li>
                            <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "CreateCategory" ? "active" : "")">
                                <a href="@Url.Action("CreateCategory", "Admin")">Add New Category</a>
                            </li>
                        </ul>
                    </div>
                </li>

                <li class="side-nav-title side-nav-item">Business Management</li>

                <li class="side-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Subscriptions" ? "active" : "")">
                    <a data-bs-toggle="collapse" href="#sidebarSubscriptions" aria-expanded="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Subscriptions" ? "true" : "false")" aria-controls="sidebarSubscriptions" class="side-nav-link">
                        <i class="mdi mdi-credit-card"></i>
                        <span> Subscriptions </span>
                        <span class="badge bg-success float-end">Pro</span>
                        <span class="menu-arrow"></span>
                    </a>
                    <div class="collapse @(ViewContext.RouteData.Values["Action"]?.ToString() == "Subscriptions" ? "show" : "")" id="sidebarSubscriptions">
                        <ul class="side-nav-second-level">
                            <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Subscriptions" ? "active" : "")">
                                <a href="@Url.Action("Subscriptions", "Admin")">All Subscriptions</a>
                            </li>
                            <li>
                                <a href="@Url.Action("Subscriptions", "Admin")?showModal=true">Add Subscription</a>
                            </li>
                        </ul>
                    </div>
                </li>

                <li class="side-nav-title side-nav-item">Communication</li>

                <li class="side-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "FeedbackReviews" ? "active" : "")">
                    <a href="@Url.Action("FeedbackReviews", "Admin")" class="side-nav-link">
                        <i class="mdi mdi-star"></i>
                        <span> Feedback Reviews </span>
                    </a>
                </li>

                <li class="side-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "ContactMessages" ? "active" : "")">
                    <a href="@Url.Action("ContactMessages", "Admin")" class="side-nav-link">
                        <i class="mdi mdi-email-outline"></i>
                        <span> Contact Messages </span>
                    </a>
                </li>

                <li class="side-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "CardSends" ? "active" : "")">
                    <a href="@Url.Action("CardSends", "Admin")" class="side-nav-link">
                        <i class="mdi mdi-send"></i>
                        <span> Card Sends </span>
                    </a>
                </li>

                <li class="side-nav-title side-nav-item">Analytics & Reports</li>

                <li class="side-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Analytics" ? "active" : "")">
                    <a href="@Url.Action("Analytics", "Admin")" class="side-nav-link">
                        <i class="mdi mdi-chart-line"></i>
                        <span> Analytics </span>
                    </a>
                </li>

                <li class="side-nav-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Reports" ? "active" : "")">
                    <a href="@Url.Action("Reports", "Admin")" class="side-nav-link">
                        <i class="mdi mdi-file-document"></i>
                        <span> Reports </span>
                    </a>
                </li>

                <li class="side-nav-title side-nav-item">System</li>>

                <li class="side-nav-item">
                    <a href="@Url.Action("Logout", "Admin")" class="side-nav-link">
                        <i class="mdi mdi-logout"></i>
                        <span> Logout </span>
                    </a>
                </li>

            </ul>

            <!-- End Sidebar -->

            <div class="clearfix"></div>

        </div>
        <!-- Sidebar -left -->

    </div>
    <!-- Left Sidebar End -->

</div>

<!-- ============================================================== -->
<!-- End Page content -->
<!-- ============================================================== -->
</div>
<!-- END wrapper -->
<!-- =========Right Sidebar============ -->
<div class="end-bar">

    <div class="rightbar-title">
        <a href="javascript:void(0);" class="end-bar-toggle float-end">
            <i class="dripicons-cross noti-icon"></i>
        </a>
        <h5 class="m-0">Settings</h5>
    </div>

    <div class="rightbar-content h-100" data-simplebar>

        <div class="p-3">
            <div class="alert alert-warning" role="alert">
                <strong>Customize </strong> the overall color scheme, sidebar menu, etc.
            </div>

            <!-- Settings -->
            <h5 class="mt-3">Color Scheme</h5>
            <hr class="mt-1" />

            <div class="form-check form-switch mb-1">
                <input class="form-check-input" type="checkbox" name="color-scheme-mode" value="light" id="light-mode-check" checked>
                <label class="form-check-label" for="light-mode-check">Light Mode</label>
            </div>

            <div class="form-check form-switch mb-1">
                <input class="form-check-input" type="checkbox" name="color-scheme-mode" value="dark" id="dark-mode-check">
                <label class="form-check-label" for="dark-mode-check">Dark Mode</label>
            </div>


            <!-- Width -->
            <h5 class="mt-4">Width</h5>
            <hr class="mt-1" />
            <div class="form-check form-switch mb-1">
                <input class="form-check-input" type="checkbox" name="width" value="fluid" id="fluid-check" checked>
                <label class="form-check-label" for="fluid-check">Fluid</label>
            </div>

            <div class="form-check form-switch mb-1">
                <input class="form-check-input" type="checkbox" name="width" value="boxed" id="boxed-check">
                <label class="form-check-label" for="boxed-check">Boxed</label>
            </div>


            <!-- Left Sidebar-->
            <h5 class="mt-4">Left Sidebar</h5>
            <hr class="mt-1" />
            <div class="form-check form-switch mb-1">
                <input class="form-check-input" type="checkbox" name="theme" value="default" id="default-check">
                <label class="form-check-label" for="default-check">Default</label>
            </div>

            <div class="form-check form-switch mb-1">
                <input class="form-check-input" type="checkbox" name="theme" value="light" id="light-check" checked>
                <label class="form-check-label" for="light-check">Light</label>
            </div>

            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" name="theme" value="dark" id="dark-check">
                <label class="form-check-label" for="dark-check">Dark</label>
            </div>

            <div class="form-check form-switch mb-1">
                <input class="form-check-input" type="checkbox" name="compact" value="fixed" id="fixed-check" checked>
                <label class="form-check-label" for="fixed-check">Fixed</label>
            </div>

            <div class="form-check form-switch mb-1">
                <input class="form-check-input" type="checkbox" name="compact" value="condensed" id="condensed-check">
                <label class="form-check-label" for="condensed-check">Condensed</label>
            </div>

            <div class="form-check form-switch mb-1">
                <input class="form-check-input" type="checkbox" name="compact" value="scrollable" id="scrollable-check">
                <label class="form-check-label" for="scrollable-check">Scrollable</label>
            </div>

            <div class="d-grid mt-4">
                <button class="btn btn-primary" id="resetBtn">Reset to Default</button>

            </div>
        </div> <!-- end padding-->

    </div>
</div>

<div class="rightbar-overlay"></div>
<!-- /End-bar -->
